# Public app-server port for iOS Simulator traffic.
APP_SERVER_PORT=3000

# Internal service ports for local host-mode startup.
AUTH_SERVICE_PORT=3101
PROFILE_SERVICE_PORT=3102
SESSION_SERVICE_PORT=3103
CONVERSATION_SERVICE_PORT=3104
CONVERSATION_SERVICE_GRPC_PORT=5104
CHAT_AGENT_SERVICE_PORT=3105

# Host-mode database URLs. Point these at existing local PostgreSQL databases.
AUTH_DATABASE_URL="postgresql://your_pg_user:your_pg_password@localhost:5432/yourpassenger_auth?schema=public"
PROFILE_DATABASE_URL="postgresql://your_pg_user:your_pg_password@localhost:5432/yourpassenger_profile?schema=public"
SESSION_DATABASE_URL="postgresql://your_pg_user:your_pg_password@localhost:5432/yourpassenger_session?schema=public"

# Auth signing secret shared by auth-service and app-server.
AUTH_TOKEN_SECRET="replace-with-a-local-dev-secret"

# Optional internal service base URLs for app-server.
AUTH_SERVICE_BASE_URL="http://localhost:3101"
PROFILE_SERVICE_BASE_URL="http://localhost:3102"
SESSION_SERVICE_BASE_URL="http://localhost:3103"
CONVERSATION_SERVICE_BASE_URL="http://localhost:3104"
CHAT_AGENT_SERVICE_BASE_URL="http://localhost:3105"
CONVERSATION_SERVICE_GRPC_URL="localhost:5104"

# Optional websocket base URL returned by POST /v1/sessions.
# PUBLIC_WS_BASE_URL="ws://localhost:3000"

# Optional LiveKit realtime transport. If all three are set, POST /v1/sessions
# returns a LiveKit room connection instead of the local websocket fallback.
# Leave these commented out until you have real LiveKit credentials: the values
# are not validated, so placeholder strings select the LiveKit path and hand the
# client a room it can never join.
# LIVEKIT_URL="wss://your-livekit-host"
# LIVEKIT_API_KEY="replace-with-livekit-api-key"
# LIVEKIT_API_SECRET="replace-with-livekit-api-secret"
LIVEKIT_PARTICIPANT_TOKEN_TTL_SECONDS=1800
LIVEKIT_AGENT_TOKEN_TTL_SECONDS=1800
LIVEKIT_AGENT_AUDIO_BUFFER_SECONDS=12
LIVEKIT_AGENT_VAD_SPEECH_RMS_THRESHOLD=0.018
LIVEKIT_AGENT_VAD_END_SILENCE_MS=800
LIVEKIT_AGENT_VAD_MIN_SPEECH_MS=280
LIVEKIT_AGENT_VAD_MAX_UTTERANCE_MS=12000

# Docker-mode PostgreSQL settings. Used by make local-up DOCKER=1.
# LOCAL_POSTGRES_USER=db_user
# LOCAL_POSTGRES_PASSWORD=db_password
# DOCKER_POSTGRES_PORT=5432

# Set to 1 to log full transcripts while debugging the voice pipeline locally.
# Leave unset anywhere real users speak: transcripts are redacted to a character
# count by default.
# LOG_TRANSCRIPTS=1

# Conversation-service local providers.
LLM_PROVIDER=mock
TTS_PROVIDER=mock
ASR_PROVIDER=mock

# OpenAI providers. Set LLM_PROVIDER/TTS_PROVIDER/ASR_PROVIDER=openai to use
# text generation, speech-to-text, and text-to-speech.
OPENAI_API_KEY="replace-with-openai-api-key"
OPENAI_LLM_MODEL="gpt-4.1-mini"
OPENAI_STT_MODEL="gpt-4o-mini-transcribe"
OPENAI_STT_LANGUAGE="zh"
OPENAI_STT_SAMPLE_RATE=16000
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_VOICE="alloy"
OPENAI_TTS_SAMPLE_RATE=24000
