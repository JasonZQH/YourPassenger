# Nest loads `.env.local` and `.env` automatically through `@nestjs/config`.
# Keep local-only overrides in `.env.local`; keep secrets out of version control.

# Local backend port. Keep the iOS client base URL aligned with this value.
PORT=3000

# Use placeholder database credentials in examples only.
# Put real local secrets in your private `.env`, never in version control.
DATABASE_URL="postgresql://db_user:db_password@localhost:5432/yourpassenger_dev?schema=public"
DATABASE_URL_TEST="postgresql://db_user:db_password@localhost:5432/yourpassenger_test?schema=public"

# Secret used to sign mock access tokens in local development.
AUTH_TOKEN_SECRET="replace-with-a-local-dev-secret"

# Optional: override the websocket base URL returned by `POST /v1/sessions`.
# Useful when the backend is not reachable as `localhost` from the client.
# PUBLIC_WS_BASE_URL="ws://localhost:3000"
