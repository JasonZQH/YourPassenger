{
  "name": "yourpassenger-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal NestJS backend skeleton for the AI Passenger MVP",
  "scripts": {
    "build": "rm -rf dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo && nest build",
    "dev": "npm run build && node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "start": "node dist/main.js",
    "start:dev": "npm run dev",
    "start:debug": "npm run build && node --inspect dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@prisma/client": "^5.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.19",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
