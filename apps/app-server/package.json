{
  "name": "@yourpassenger/app-server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/apps/app-server/src/main.js",
